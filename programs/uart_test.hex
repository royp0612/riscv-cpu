100000b7 // lui x1, 0x10000 (MMIO base)
04800113 // addi x2, x0, 'H'
0020aa23 // sw x2, 20(x1) (transmit H)
0020aa23 // sw x2, 20(x1) (ignored while busy)
0180a183 // lw x3, 24(x1) (read busy)
fe019ee3 // bne x3, x0, -4 (poll until idle)
00208aa3 // sb x2, 21(x1) (ignored: not the TX low byte)
06900113 // addi x2, x0, 'i'
00208a23 // sb x2, 20(x1) (transmit i)
0180a183 // lw x3, 24(x1)
fe019ee3 // bne x3, x0, -4
00000663 // beq x0, x0, 12 (skip both UART stores)
00208a23 // sb x2, 20(x1) (wrong path)
00208a23 // sb x2, 20(x1) (wrong path)
0000006f // jal x0, 0
